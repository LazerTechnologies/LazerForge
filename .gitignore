/broadcast/**/dry-run/

# Local anvil deployment records (chain id 31337)
/deployments/31337.json

# Docs
docs/

# Dotenv file
.env
.env.*

.DS_Store

# coverage
coverage/
lcov.info

# ffi related
test-ffi/scripts/node_modules
test-ffi/tmp/temp*
